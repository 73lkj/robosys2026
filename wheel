import sys, math

try:
    if sys.argv[1] == "-r":          #回転モード
        mode = 1
        d = float(sys.argv[2])       #直径受け取る
    else:
        mode = 0
        d = float(sys.argv[1])
except (IndexError, ValueError):
    print("wheel: 直径を正の数で指定して下さい", file=sys.stderr)
    sys.exit(1)                          #終了ステータス1

if d <= 0:                               #直径が0以下ならエラー
    print("wheel: 直径を正の数で指定して下さい", file=sys.stderr)
    sys.exit(1)                          #終了ステータス1

for line in sys.stdin:                   #1つずつ読む
    try:
        n = float(line)
    except ValueError:
        print("wheel: 数字を入力してください", file=sys.stderr)
        sys.exit(1)


    if mode == 0:
        print(f"{d * math.pi * n:.2f}")              #距離計算
    else:
        print(f"{n / (d * math.pi):.2f}")            #回転計算