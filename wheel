import sys

try:
    d = float(sys.argv[1])       #直径は1番目の引数
except (IndexError, ValueError):
    print("wheel: 直径を正の数で指定して下さい", file=sys.stderr)
    sys.exit(1)                          #終了ステータス1

if d <= 0:
    print("wheel: 直径を正の数で指定して下さい", file=sys.stderr)
    sys.exit(1)                          #終了ステータス1

for line in sys.stdin:
    try:
        n = float(line)
    except ValueError:
        print("wheel: 数字を入力してください", file=sys.stderr)
        sys.exit(1)

    print(round(d * 3.14 * n, 2))              #距離直径3.14回転数